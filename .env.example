# AI Merch Factory environment template
# NEVER commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

MONGODB_URI=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=

AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
# Optional text model (default gemini-2.5-flash-lite). Reuses GEMINI_API when AI_TEXT_API_KEY empty.
# AI_TEXT_MODEL=

IMAGE_PROVIDER=
IMAGE_API_KEY=
# Aliases also accepted: GOOGLE_API_KEY, GEMINI_API_KEY, GEMINI_API
# Optional: gemini-3.1-flash-image (default). Fallbacks include gemini-2.5-flash-image.
IMAGE_MODEL=

# Trend research (themes only — never copy third-party artwork)
SERPAPI_API_KEY=
ETSY_API_KEY=
ETSY_SHARED_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Webhooks (verify before trusting live order events)
SHOPIFY_WEBHOOK_SECRET=
PRINTIFY_WEBHOOK_SECRET=

AUTH_SECRET=
ADMIN_SETUP_TOKEN=

# Optional: protect GET /api/cron/automation (Vercel Cron)
CRON_SECRET=

HUMAN_APPROVAL=true
AUTO_PUBLISH=false
MIN_DESIGN_QUALITY_SCORE=85
MIN_SAFETY_SCORE=90

# Security (required for admin dashboard):
# AUTH_SECRET — 32+ random chars (signs session cookies)
# ADMIN_SETUP_TOKEN — 16+ random chars (only you know; required to set Admin password the first time)
# MONGODB_URI — stores bcrypt password hash (never plaintext)
# Password is never committed or logged. After first setup, only Admin + your password can sign in.
